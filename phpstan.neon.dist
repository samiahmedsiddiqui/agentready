parameters:
	level: 5
	treatPhpDocTypesAsCertain: false
	phpVersion:
		min: 80000
		max: 80599
	paths:
		- agentready.php
		- uninstall.php
		- src
	bootstrapFiles:
		- .phpstan/bootstrap.php
	scanFiles:
		- .phpstan/wp-cli.php
	excludePaths:
		- src/Admin/views
	ignoreErrors:
		# Temporary: PR 3 and PR 4 stubs accept dependencies they do not use yet.
		-
			identifier: property.onlyWritten
			path: src/Robots/RobotsTxt.php
